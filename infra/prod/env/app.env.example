# /etc/lokdhara/app.env: the API, worker and migrations. EXAMPLE ONLY; copy to the server,
# fill in, `chmod 600`. Every LKD_ setting is described in the repository's .env.example.
LKD_ENV=production
LKD_BASE_URL=https://lokdhara.example.org
LKD_SECRET_KEY=                       # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
LKD_IDENTITY_ENCRYPTION_KEY=          # python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
                                      # keep a copy in the password manager: backups are useless without it

# The app logs in as a member of app_rw, the deletion routine as a member of app_erasure, and
# migrations as the schema owner (docs/DEPLOYMENT.md §3, docs/ops/RUNBOOK.md §2).
LKD_DATABASE_URL=postgresql+psycopg://lokdhara_app:CHANGE_ME@db:5432/lokdhara
LKD_ERASURE_DATABASE_URL=postgresql+psycopg://lokdhara_eraser:CHANGE_ME@db:5432/lokdhara
LKD_MIGRATION_DATABASE_URL=postgresql+psycopg://lokdhara:CHANGE_ME@db:5432/lokdhara

# Private buckets at the chosen provider (Q-L7, Q-P5); versioning on for originals and consent
# evidence, no compliance-mode object lock (it would stop withdrawals).
LKD_STORAGE_BACKEND=s3
LKD_S3_ENDPOINT_URL=https://s3.example-provider.com
LKD_S3_REGION=
LKD_S3_ACCESS_KEY_ID=
LKD_S3_SECRET_ACCESS_KEY=
LKD_BUCKET_QUARANTINE=lokdhara-quarantine
LKD_BUCKET_ORIGINALS=lokdhara-originals
LKD_BUCKET_DERIVED=lokdhara-derived
LKD_BUCKET_CONSENT_EVIDENCE=lokdhara-consent-evidence
LKD_BUCKET_EXPORTS=lokdhara-exports

LKD_ALLOW_MINORS=true                # under-18s take part with a guardian (Q-L4)
LKD_EXTERNAL_RELEASES_ENABLED=false   # stays false until Q-G1, Q-G5, Q-L5 are answered
LKD_WITHDRAWAL_CONSENT_EVIDENCE_DAYS=30
LKD_LOG_LEVEL=INFO

# Daily digest (counts only) to the maintainers, through any mail provider's SMTP server.
LKD_SMTP_HOST=
LKD_SMTP_PORT=587
LKD_SMTP_USERNAME=
LKD_SMTP_PASSWORD=
LKD_SMTP_FROM=
LKD_DIGEST_RECIPIENTS=
