# /etc/lokdhara/web.env: Caddy, the web server. EXAMPLE ONLY.
LKD_DOMAIN=lokdhara.example.org       # its DNS A record must point at this server
LKD_ACME_EMAIL=                       # a maintainer's address, for certificate expiry notices
# Where signed audio and image links point: the object storage endpoint, scheme and host only.
LKD_STORAGE_ORIGIN=https://s3.example-provider.com
