# /etc/lokdhara/backup.env: the backup container. EXAMPLE ONLY; `chmod 600` on the server.
# The database login is a member of app_backup (docs/ops/RUNBOOK.md §2).
BACKUP_DATABASE_URL=postgresql://lokdhara_backup:CHANGE_ME@db:5432/lokdhara
BACKUP_DATABASE_HOUR_UTC=21

# Off-site copy with rclone, to a bucket at a DIFFERENT provider or account from the app's
# storage. Use a key limited to that bucket, and turn on the provider's versioning there so a
# stolen key cannot erase older copies. Empty BACKUP_REMOTE
# keeps backups on this server only, which the admin status page will flag.
BACKUP_REMOTE=offsite:lokdhara-backups
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.backup-provider.example
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
