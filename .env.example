# Lokdhara environment variables — EXAMPLE ONLY.
# Copy to .env for local development. Never commit .env or real values.
# Production values live in the host's secret store, not in this repository.
# Variables are consumed by backend/app/config.py (pydantic-settings) from Milestone 1.

# ---- Application ----
LKD_ENV=development                 # development | test | staging | production
LKD_BASE_URL=http://localhost:5173
LKD_SECRET_KEY=change-me-local-only # random 32+ bytes in real environments
LKD_SESSION_IDLE_HOURS_CONTRIBUTOR=168
LKD_SESSION_IDLE_HOURS_STAFF=12
LKD_SESSION_ABSOLUTE_DAYS=30
LKD_PASSWORD_RESET_HOURS=24
LKD_LOGIN_MAX_FAILURES=5           # per account, within the window
LKD_LOGIN_MAX_FAILURES_PER_IP=20
LKD_LOGIN_WINDOW_MINUTES=15
LKD_LOGIN_LOCKOUT_MINUTES=15
LKD_REQUIRE_ADMIN_MFA=             # empty: required everywhere except development and test

# ---- Database (PostgreSQL 18) ----
LKD_DATABASE_URL=postgresql+psycopg://lokdhara:lokdhara@localhost:5432/lokdhara
# Schema owner for `alembic upgrade head`; defaults to LKD_DATABASE_URL (fine for local dev).
# In staging/production the app URL must be a member of app_rw, not the owner.
LKD_MIGRATION_DATABASE_URL=

# ---- Object storage ----
LKD_STORAGE_BACKEND=local           # local | s3
LKD_LOCAL_STORAGE_DIR=./.local-storage
LKD_S3_ENDPOINT_URL=
LKD_S3_REGION=
LKD_S3_ACCESS_KEY_ID=
LKD_S3_SECRET_ACCESS_KEY=
LKD_S3_FORCE_PATH_STYLE=false      # true for providers that need path-style URLs
LKD_BUCKET_QUARANTINE=lokdhara-quarantine
LKD_BUCKET_ORIGINALS=lokdhara-originals
LKD_BUCKET_DERIVED=lokdhara-derived
LKD_BUCKET_CONSENT_EVIDENCE=lokdhara-consent-evidence
LKD_BUCKET_EXPORTS=lokdhara-exports
LKD_SIGNED_URL_TTL_SECONDS=600     # at most 600 (10 minutes)

# ---- Upload and audio limits ----
LKD_MAX_UPLOAD_BYTES=104857600      # 100 MB
LKD_MAX_AUDIO_SECONDS=1800          # 30 min
LKD_MIN_AUDIO_SECONDS=1
LKD_MAX_AUDIO_CHANNELS=2
LKD_MIN_SAMPLE_RATE_HZ=8000
LKD_MAX_SAMPLE_RATE_HZ=96000
LKD_FFMPEG_TIMEOUT_SECONDS=300      # per ffprobe/FFmpeg run, well under the worker lease
LKD_UPLOADS_PER_USER_PER_HOUR=60
LKD_DRAFT_UPLOAD_RETENTION_DAYS=30   # audio of a draft never submitted is deleted after this (Q-T7)

# ---- Encryption of restricted identity fields ----
LKD_IDENTITY_ENCRYPTION_KEY=        # base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
                                    # required outside development/test; never reuse across environments

# ---- Consent capture ----
LKD_CONSENT_EVIDENCE_MAX_BYTES=26214400   # 25 MB oral consent recording
LKD_ALLOW_MINORS=false              # stays false until Q-L4 is answered

# Dataset releases (docs/DATASET_VERSIONING.md)
LKD_EXTERNAL_RELEASES_ENABLED=false # only internal research releases until Q-G1, Q-G5, Q-L5 are answered
LKD_RELEASE_SPEAKER_SHARE_WARNING=0.3
LKD_EXPORT_RETENTION_DAYS=7
LKD_GIT_COMMIT=unknown              # set by the deployment; recorded in each frozen release

# Withdrawals (docs/DATA_RETENTION_AND_DELETION.md). The deletion routine logs in as a member of
# app_erasure; left empty it uses LKD_DATABASE_URL, which must then be allowed to
# SET ROLE app_erasure (the local development superuser is).
LKD_ERASURE_DATABASE_URL=
LKD_WITHDRAWAL_KEEP_CONSENT_EVIDENCE=true # keep proof of consent after a withdrawal until Q-G8

# ---- Prompt library media (team-made images and spoken prompts) ----
LKD_PROMPT_IMAGE_MAX_BYTES=5242880   # 5 MB
LKD_PROMPT_AUDIO_MAX_BYTES=10485760  # 10 MB

# ---- Observability (optional) ----
LKD_LOG_LEVEL=INFO
LKD_SENTRY_DSN=

# Daily digest to the maintainers: counts only, no names or content. Not sent unless both a
# mail server and recipients are set; the admin status page shows the same facts.
LKD_SMTP_HOST=
LKD_SMTP_PORT=587
LKD_SMTP_USERNAME=
LKD_SMTP_PASSWORD=
LKD_SMTP_FROM=
LKD_SMTP_STARTTLS=true
LKD_DIGEST_RECIPIENTS=              # comma-separated addresses

# ---- Worker ----
LKD_WORKER_POLL_SECONDS=5
LKD_WORKER_LEASE_SECONDS=900        # a job not finished in time is handed to another worker
